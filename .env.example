# --- LLM: Gemini and Groq only ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Tiers: fast (expansion, matcher) | smart (fact checker, judge) | adversary (devil's advocate)
# Defaults: fast/smart = gemini-2.5-flash, adversary = groq openai/gpt-oss-120b (different model family on purpose)
# FAST_PROVIDER=gemini     FAST_MODEL=gemini-2.5-flash
# SMART_PROVIDER=gemini    SMART_MODEL=gemini-2.5-pro
# ADVERSARY_PROVIDER=groq  ADVERSARY_MODEL=openai/gpt-oss-120b
# GROQ_MAX_INPUT_CHARS=14000   # prompts bigger than this go to Gemini (Groq free tier ~6k tokens/min)
# LLM_FALLBACK=1               # if one provider fails/rate-limits, try the other (needs both keys)
# --- storage ---
DATABASE_URL=sqlite:///tracer.db
# --- data sources ---
BSKY_HANDLE=your_handle.bsky.social                # Bluesky search is usually auth-gated; use an app password
BSKY_APP_PASSWORD=your_app_password_here
TRACER_CONTACT=you@example.com    # goes in the User-Agent (SEC EDGAR / Wikipedia ask for this)
USE_PLAYWRIGHT=0                  # 1 = JS rendering + resolves Google News redirect links
