# --- LLM providers ---
GROQ_API_KEY=your_groq_api_key_here
# Get a free OpenRouter key at https://openrouter.ai/keys  (no credit card needed for free models)
OPENROUTER_API_KEY=your_openrouter_key_here
# GEMINI_API_KEY=your_gemini_api_key_here  # optional; only needed if you set a tier to provider=gemini

# Tiers: fast (expansion, matcher) | smart (fact checker, judge) | adversary (devil's advocate)
# Providers: openrouter | groq | gemini
# Free OpenRouter models: https://openrouter.ai/models?q=free
# FAST_PROVIDER=openrouter   FAST_MODEL=google/gemini-2.0-flash-exp:free
# SMART_PROVIDER=openrouter  SMART_MODEL=google/gemini-2.0-flash-exp:free
# ADVERSARY_PROVIDER=groq    ADVERSARY_MODEL=openai/gpt-oss-120b
# GROQ_MAX_INPUT_CHARS=14000   # prompts bigger than this skip Groq (free tier ~6k tokens/min)
# LLM_FALLBACK=1               # if one provider fails/rate-limits, try the next one

# --- storage ---
DATABASE_URL=sqlite:///tracer.db

# --- data sources ---
BSKY_HANDLE=your_handle.bsky.social                # Bluesky search is usually auth-gated; use an app password
BSKY_APP_PASSWORD=your_app_password_here
TRACER_CONTACT=you@example.com    # goes in the User-Agent (SEC EDGAR / Wikipedia ask for this)
USE_PLAYWRIGHT=0                  # 0 = no Chromium; 1 = JS render + Google News redirect (slow)
# SEARXNG_URL=http://localhost:8888  # optional: self-hosted SearXNG fallback when DuckDuckGo throttles
