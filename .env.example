# --- LLM providers ---
# Get a free OpenRouter key at https://openrouter.ai/keys  (no credit card needed for :free models)
OPENROUTER_API_KEY=your_openrouter_key_here
# GROQ_API_KEY=your_groq_api_key_here      # optional fallback provider
# GEMINI_API_KEY=your_gemini_api_key_here  # optional fallback provider (pip install google-genai)

# --- pipeline mode ---
# single (default): gather + rank all evidence with zero LLM calls, then ONE consolidated LLM analysis per run
# agents: legacy 8-agent loop (6+ LLM calls per round; exhausts free-tier quotas quickly)
# TRACER_MODE=single

# --- OpenRouter free models ---
# Free models are rate limited (~20 req/min, 50 req/day without credits) and get retired without notice.
# A call walks this list in order and moves to the next model on 404 / 429 / empty output.
# Run `python check_setup.py` to see the live list of free models and flag retired ones.
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
# SMART_MODEL=google/gemma-4-31b-it:free   # pin the first model tried for the analysis call
# SMART_PROVIDER=openrouter                # openrouter | groq | gemini
# LLM_FALLBACK=1                           # if OpenRouter fails entirely, try other providers that have keys
# ANALYSIS_MAX_CHARS=28000                 # evidence budget for the single analysis prompt
# ANALYSIS_MAX_ITEMS=30

# --- storage ---
DATABASE_URL=sqlite:///tracer.db

# --- data sources ---
# Optional: Google Fact Check Tools API key (free) adds ClaimReview ratings from fact-checkers worldwide
# GOOGLE_FACTCHECK_API_KEY=
BSKY_HANDLE=your_handle.bsky.social                # Bluesky search is usually auth-gated; use an app password
BSKY_APP_PASSWORD=your_app_password_here
TRACER_CONTACT=you@example.com    # goes in the API User-Agent (SEC EDGAR / Wikipedia ask for this)
USE_PLAYWRIGHT=0                  # 0 = no Chromium; 1 = JS render + Google News redirect (slow)
# SEARXNG_URL=http://localhost:8888  # optional: self-hosted SearXNG fallback when DuckDuckGo throttles
